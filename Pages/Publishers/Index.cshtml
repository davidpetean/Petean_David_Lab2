@page "{id:int?}"
@model Petean_David_Lab2.Pages.Publishers.IndexModel

@{
    ViewData["Title"] = "Publishers";
}

<h1>Publishers</h1>

<p>
    <a class="btn btn-primary" asp-page="Create">Create New</a>
</p>

<div class="row">
    <div class="col-md-6">
        <h3>Publishers List</h3>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>
                        @if (Model.PublisherData.Publishers.Any())
                        {
                            @Html.DisplayNameFor(model => model.PublisherData.Publishers.First().PublisherName)
                        }
                        else
                        {
                            @Html.DisplayName("Publisher Name")
                        }
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.PublisherData.Publishers)
                {
                    string selectedRow = "";
                    if (item.ID == Model.PublisherID)
                    {
                        selectedRow = "table-success";
                    }

                    <tr class="@selectedRow">
                        <td>
                            <a asp-page="./Index" asp-route-id="@item.ID">
                                @Html.DisplayFor(modelItem => item.PublisherName)
                            </a>
                        </td>
                        <td>
                            <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                            <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                            <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-md-6">
        @if (Model.PublisherData.Books != null)
        {
            <h3>Books Edited by Selected Publisher</h3>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Title, Author, and Price</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PublisherData.Books)
                    {
                        string selectedRow = "";
                        if (item.ID == Model.BookID)
                        {
                            selectedRow = "table-success";
                        }

                        <tr class="@selectedRow">
                            <td>
                                @item.Title by @item.Author.FullName (@item.Price.ToString())
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>