@page
@model Petean_David_Lab2.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Categories Index (Master-Detail)</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CategoryD.Categories.FirstOrDefault().CategoryName)
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.CategoryD.Categories)
        {
            string selectedRow = "";
            if (item.ID == Model.CategoryID)
            {
                selectedRow = "table-success";
            }

            <tr class="@selectedRow">
                <td>
                    <a asp-page="./Index" asp-route-id="@item.ID">
                        @Html.DisplayFor(modelItem => item.CategoryName)
                    </a>
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.CategoryD.Books != null && Model.CategoryD.Books.Any())
{
    <h3>Books in Category: @Model.CategoryD.Categories.FirstOrDefault(c => c.ID == Model.CategoryID)?.CategoryName</h3>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.CategoryD.Books)
            {
                <tr>
                    <td>
                        @book.Title
                    </td>
                    <td>
                        @(book.Author?.FullName ?? $"{book.Author?.FirstName} {book.Author?.LastName}")
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
